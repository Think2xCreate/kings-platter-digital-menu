rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Menu images and business assets are publicly readable
    match /menu/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    
    match /business/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
